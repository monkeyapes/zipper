Windows Registry Editor Version 5.00

; Add "Open with LocalName" to the right-click menu for .mcaddon files
; Leaves Minecraft Bedrock as the default handler

[HKEY_CLASSES_ROOT\LocalName.Addon]
@="Minecraft Addon"

[HKEY_CLASSES_ROOT\LocalName.Addon\shell\open\command]
@="\"D:\\minecraftluckyblcok\\localname_app\\build\\LocalName.exe\" \"%1\""

[HKEY_CLASSES_ROOT\.mcaddon\OpenWithList\LocalName.exe]
@=""

[HKEY_CLASSES_ROOT\.mcpack\OpenWithList\LocalName.exe]
@=""

[HKEY_CLASSES_ROOT\.mcworld\OpenWithList\LocalName.exe]
@=""
